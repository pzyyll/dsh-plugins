{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run DSH IDE Selection VS Code Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/dsh-ide-selection/ide-plugins/vscode",
        "${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/packages/dsh-ide-selection/ide-plugins/vscode/out/extension.js"
      ],
      "sourceMaps": true,
      "preLaunchTask": "mise: compile:vsix"
    }
  ]
}
