{
  "name": "dsh-my-preset",
  "version": "0.1.0",
  "private": true,
  "description": "Agent presets M-PTC and M-Creator: shipped presets without the native web tools, with Exa MCP instead.",
  "repository": {
    "type": "git",
    "url": "https://github.com/pzyyll/dsh-plugins.git",
    "directory": "packages/dsh-my-preset"
  },
  "files": [
    "presets/*.patch.yml",
    "locale/*.json",
    "docs/detail.md",
    "docs/detail.zh-CN.md"
  ],
  "type": "module",
  "exports": {
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./presets/m-ptc.patch.yml",
        "./presets/m-creator.patch.yml"
      ]
    }
  }
}
