{
  "name": "@balaenis/dsh-ide-selection",
  "version": "0.3.0",
  "description": "Shows the current VS Code selection and adds it to accepted human turns.",
  "repository": {
    "type": "git",
    "url": "https://github.com/pzyyll/dsh-plugins.git",
    "directory": "packages/dsh-ide-selection"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/client.js",
    "dist/client.js.map",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "catalog:",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-client-connection": "catalog:",
    "@deepseek-ai/dsh-commands": "catalog:",
    "@deepseek-ai/dsh-host-webserver": "catalog:",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-workspace": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/vscode": "catalog:",
    "@types/ws": "catalog:",
    "esbuild": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-workspace": "*"
  },
  "engines": {
    "node": "^24.9.0",
    "pnpm": "12.16.1"
  },
  "packageManager": "pnpm@12.16.1",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
