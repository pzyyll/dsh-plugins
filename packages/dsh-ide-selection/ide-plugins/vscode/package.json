{
  "name": "dsh-ide-selection-vscode",
  "displayName": "DSH IDE Selection (VS Code)",
  "version": "0.3.0",
  "private": true,
  "description": "Shares VS Code editor selections with the local DSH IDE bridge.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/pzyyll/dsh-plugins.git",
    "directory": "packages/dsh-ide-selection/ide-plugins/vscode"
  },
  "publisher": "balaenis",
  "type": "commonjs",
  "main": "./out/extension.js",
  "scripts": {
    "compile": "node scripts/build.mjs",
    "compile:prod": "node scripts/build.mjs --production",
    "package": "pnpm run compile:prod && node scripts/package.mjs"
  },
  "devDependencies": {
    "@vscode/vsce": "catalog:",
    "esbuild": "catalog:"
  },
  "contributes": {
    "commands": [
      {
        "command": "dsh-ide-selection.showConnectionStatus",
        "title": "DSH: Show IDE Connection Status"
      },
      {
        "command": "dsh-ide-selection.fixDiagnostic",
        "title": "DSH: Fix it"
      },
      {
        "command": "dsh-ide-selection.sendDiagnostic",
        "title": "DSH: Send diagnostic"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "dsh-ide-selection.fixDiagnostic",
          "when": "false"
        },
        {
          "command": "dsh-ide-selection.sendDiagnostic",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "DSH IDE Selection",
      "properties": {
        "dshIdeSelection.lockDir": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Absolute local lock-directory override; leave empty to use the default."
        }
      }
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace"
  ],
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.144.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The local DSH bridge is only started for trusted workspaces."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  }
}
