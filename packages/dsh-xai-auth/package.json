{
  "name": "@balaenis/dsh-xai-auth",
  "version": "0.1.3",
  "description": "dsh plugin that signs in to an xAI SuperGrok subscription and serves it as the xai-supergrok model route.",
  "keywords": [
    "authentication",
    "dsh-plugin",
    "grok",
    "oauth",
    "subscription",
    "supergrok",
    "xai",
    "xai-supergrok"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pzyyll/dsh-plugins.git",
    "directory": "packages/dsh-xai-auth"
  },
  "files": [
    "dist",
    "lib/client.js",
    "locale",
    "docs/detail.md",
    "docs/detail.zh-CN.md",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-credentials": "catalog:",
    "@deepseek-ai/dsh-home-paths": "catalog:",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-llm-pi-ai": "catalog:",
    "@deepseek-ai/dsh-typert-protocol": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@rsbuild/core": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-home-paths": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-llm-pi-ai": "*",
    "@deepseek-ai/dsh-typert-protocol": "*",
    "@earendil-works/pi-ai": "*"
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0",
    "node": ">=24.9.0"
  },
  "packageManager": "pnpm@12.16.1",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
